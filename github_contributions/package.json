{
  "name": "GitHub Contributions",
  "version": "1.1.0",
  "hash": "7657c374d88d",
  "description": "Anyone's contribution graph, live from GitHub",
  "author": "martinwoodward",
  "category": "Information",
  "requires_internet": true,
  "tags": [
    "github",
    "contributions",
    "graph"
  ],
  "min_firmware": "0.1.0",
  "settings": [
    {
      "key": "username",
      "type": "text",
      "label": "GitHub username",
      "placeholder": "octocat"
    },
    {
      "key": "refresh_days",
      "type": "int",
      "label": "Refresh every (days)",
      "min": 1,
      "max": 6,
      "default": 1,
      "help": "GitHub updates this data once a day"
    },
    {
      "key": "colour",
      "type": "color",
      "label": "Colour",
      "default": "#39d353"
    }
  ],
  "urls": [
    [
      "plugins/github_contributions/__init__.py",
      "__init__.py"
    ],
    [
      "plugins/github_contributions/thumbnail.png",
      "thumbnail.png"
    ]
  ]
}
